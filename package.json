{
  "name": "@hanzo/iam",
  "version": "0.13.8",
  "private": true,
  "description": "TypeScript SDK for Hanzo IAM \u2014 OIDC auth, JWT validation, OAuth2 PKCE, user/org/project APIs",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./auth": {
      "import": "./dist/auth.js",
      "require": "./dist/auth.cjs",
      "default": "./dist/auth.js"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./session": {
      "import": "./dist/session.js",
      "require": "./dist/session.cjs"
    },
    "./paths": {
      "import": "./dist/paths.js",
      "require": "./dist/paths.cjs",
      "default": "./dist/paths.js"
    },
    "./server": {
      "import": "./dist/server.js",
      "require": "./dist/server.cjs",
      "default": "./dist/server.js"
    },
    "./types": {
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./react": {
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./views": {
      "import": "./dist/views.js",
      "require": "./dist/views.cjs"
    },
    "./nextauth": {
      "import": "./dist/nextauth.js",
      "require": "./dist/nextauth.cjs"
    },
    "./sveltekit": {
      "import": "./dist/sveltekit.js",
      "require": "./dist/sveltekit.cjs"
    },
    "./remix": {
      "import": "./dist/remix.js",
      "require": "./dist/remix.cjs"
    },
    "./express": {
      "import": "./dist/express.js",
      "require": "./dist/express.cjs"
    },
    "./hono": {
      "import": "./dist/hono.js",
      "require": "./dist/hono.cjs"
    },
    "./passport": {
      "import": "./dist/passport.js",
      "require": "./dist/passport.cjs"
    },
    "./betterauth": {
      "import": "./dist/betterauth.js",
      "require": "./dist/betterauth.cjs"
    },
    "./validation": {
      "import": "./dist/validation.js",
      "require": "./dist/validation.cjs",
      "default": "./dist/validation.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup && pnpm declarations",
    "declarations": "tsc -p tsconfig.build.json && node scripts/cts.mjs",
    "dev": "tsup --watch --onSuccess \"pnpm declarations\"",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepare": "pnpm build",
    "test": "node --test --import tsx \"src/**/*.test.ts\""
  },
  "dependencies": {
    "jose": "catalog:",
    "libphonenumber-js": "catalog:",
    "passport-oauth2": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.2.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/passport-oauth2": "catalog:",
    "@types/react": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "keywords": [
    "hanzo",
    "iam",
    "oidc",
    "oauth2",
    "pkce",
    "auth",
    "jwt",
    "identity",
    "access-management",
    "sso"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/iam-sdk"
  },
  "homepage": "https://docs.hanzo.ai/services/iam/sdk",
  "bugs": {
    "url": "https://github.com/hanzoai/iam-sdk/issues"
  },
  "author": "Hanzo AI <engineering@hanzo.ai>",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@9.15.9"
}
